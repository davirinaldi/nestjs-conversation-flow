{
  "name": "@conversation-flow/redis",
  "version": "0.1.0",
  "description": "Redis storage adapter for @conversation-flow/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "ioredis": "^5.4.0"
  },
  "peerDependencies": {
    "@conversation-flow/core": ">=0.1.0"
  },
  "devDependencies": {
    "@conversation-flow/core": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trier-Projetos/nestjs-conversation-flow",
    "directory": "packages/redis"
  },
  "keywords": ["conversation-flow", "redis", "storage", "session"],
  "license": "MIT"
}
