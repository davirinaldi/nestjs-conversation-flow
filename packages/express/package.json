{
  "name": "@conversation-flow/express",
  "version": "0.1.0",
  "description": "Express adapter for @conversation-flow/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@conversation-flow/core": "0.1.0",
    "@types/express": "^5.0.0",
    "express": "^4.21.0"
  },
  "peerDependencies": {
    "@conversation-flow/core": ">=0.1.0",
    "express": ">=4.0.0"
  },
  "license": "MIT"
}
