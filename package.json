{
  "name": "nestjs-conversation-flow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "clean": "rm -rf packages/*/dist packages/*/coverage",
    "publish:all": "npm run build && npm publish --workspace=packages/core --access public && npm publish --workspace=packages/nestjs --access public && npm publish --workspace=packages/redis --access public && npm publish --workspace=packages/express --access public"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.5.0",
    "typescript": "~5.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    },
    "roots": [
      "<rootDir>/packages/"
    ],
    "testMatch": [
      "**/tests/**/*.spec.ts",
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "packages/*/src/**/*.ts",
      "!**/*.d.ts",
      "!**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
